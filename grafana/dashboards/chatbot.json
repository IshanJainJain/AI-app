{
  "title": "Local AI Chat",
  "uid": "chatbot-main",
  "version": 3,
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["chatbot", "agents", "llm"],
  "panels": [

    {
      "id": 100, "type": "row", "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },

    {
      "id": 1, "type": "stat", "title": "Request Rate",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(rate(chatbot_http_server_duration_milliseconds_count{http_target!=\"/health\"}[2m]))",
        "legendFormat": "req/s"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },

    {
      "id": 2, "type": "stat", "title": "Active Requests",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(chatbot_http_server_active_requests) or vector(0)",
        "legendFormat": "active"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "value": null, "color": "green" },
          { "value": 10, "color": "yellow" },
          { "value": 50, "color": "red" }
        ] } } }
    },

    {
      "id": 3, "type": "stat", "title": "HTTP p95 Latency",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(chatbot_http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "value": null, "color": "green" },
          { "value": 500, "color": "yellow" },
          { "value": 2000, "color": "red" }
        ] } } }
    },

    {
      "id": 4, "type": "stat", "title": "LLM Calls (1h)",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(chatbot_llm_latency_ms_milliseconds_count[1h]))",
        "legendFormat": "calls"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },

    {
      "id": 5, "type": "stat", "title": "LLM p95 Latency",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(chatbot_llm_latency_ms_milliseconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms",
        "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "value": null, "color": "green" },
          { "value": 3000, "color": "yellow" },
          { "value": 8000, "color": "red" }
        ] } } }
    },

    {
      "id": 6, "type": "stat", "title": "Agent Tasks (1h)",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum(increase(chatbot_agent_tasks_total[1h])) or vector(0)",
        "legendFormat": "tasks"
      }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } } }
    },

    {
      "id": 101, "type": "row", "title": "HTTP Traffic",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }
    },

    {
      "id": 7, "type": "timeseries", "title": "Request Rate by Route",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (http_method, http_target) (rate(chatbot_http_server_duration_milliseconds_count{http_target!=\"/health\"}[2m]))",
        "legendFormat": "{{http_method}} {{http_target}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } }
    },

    {
      "id": 8, "type": "timeseries", "title": "HTTP Latency — p50 / p95 / p99",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(chatbot_http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(chatbot_http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(chatbot_http_server_duration_milliseconds_bucket{http_target!=\"/health\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 11, "type": "timeseries", "title": "5xx Error Rate",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (http_target) (rate(chatbot_http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[2m])) or vector(0)",
        "legendFormat": "5xx {{http_target}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 }, "color": { "fixedColor": "red", "mode": "fixed" } } },
      "options": { "tooltip": { "mode": "multi" } }
    },

    {
      "id": 12, "type": "timeseries", "title": "Request / Response Size (p95 bytes)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(chatbot_http_server_request_size_bytes_bucket[5m])) by (le))", "legendFormat": "request p95" },
        { "expr": "histogram_quantile(0.95, sum(rate(chatbot_http_server_response_size_bytes_bucket[5m])) by (le))", "legendFormat": "response p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" } }
    },

    {
      "id": 102, "type": "row", "title": "LLM & Agent",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 }
    },

    {
      "id": 9, "type": "timeseries", "title": "LLM Latency — p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(chatbot_llm_latency_ms_milliseconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(chatbot_llm_latency_ms_milliseconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(chatbot_llm_latency_ms_milliseconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 10, "type": "timeseries", "title": "LLM Calls per Minute by Agent",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (agent_type, model) (rate(chatbot_llm_latency_ms_milliseconds_count[2m])) * 60",
        "legendFormat": "{{agent_type}} / {{model}}"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] } }
    },

    {
      "id": 103, "type": "row", "title": "Application Logs",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }
    },

    {
      "id": 13, "type": "logs", "title": "Logs (chatbot-backend / worker / beat)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 10 },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{job=\"chatbot\"}",
        "legendFormat": ""
      }],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },

    {
      "id": 104, "type": "row", "title": "Knowledge Base Health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 }
    },

    {
      "id": 14, "type": "stat", "title": "Degraded KB Documents",
      "gridPos": { "x": 0, "y": 41, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "chatbot_kb_degraded_documents_total or vector(0)",
        "legendFormat": "degraded"
      }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "red" }
          ] }
        }
      }
    },

    {
      "id": 15, "type": "timeseries", "title": "Degraded KB Documents Over Time",
      "gridPos": { "x": 6, "y": 41, "w": 18, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "chatbot_kb_degraded_documents_total or vector(0)",
        "legendFormat": "FAISS fallback docs"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "red" }
          ] }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    }

  ]
}
