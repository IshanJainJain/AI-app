# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
# LM Studio (default)
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model

# Uncomment for OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Uncomment for Ollama:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Vision model (for image context extraction; can reuse LLM_MODEL)
VISION_LLM_MODEL=local-model

# ── Embeddings (Ollama default) ───────────────────────────────────────────────
EMBED_BASE_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
EMBED_TIMEOUT_SECONDS=120

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=60

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ── Data stores ───────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://chatbot-mongo:27017
MONGODB_DB=chatbot
REDIS_URL=redis://chatbot-redis:6379

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=360
RAG_CHUNK_OVERLAP=0
AGENTIC_CHUNK_MODEL=local-model
AGENTIC_CHUNK_WINDOW_SIZE=5
AGENTIC_CHUNK_TARGET_CHARS=360
AGENTIC_CHUNK_MAX_CHARS=1800
AGENTIC_CHUNK_TIMEOUT_SECONDS=300
MAX_DOCUMENT_BYTES=52428800
VECTOR_STORE_NAME=.vector_store
KNOWLEDGE_BASE_DIR=knowledge_base

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=chatbot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://chatbot-otel:4317
